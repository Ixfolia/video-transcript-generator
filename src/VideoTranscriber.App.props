<Project>
  <!--
    Packaging shared by the two executables (the desktop app and the command-line app): the native Whisper
    runtimes, the optional Visual C++ runtime, and self-contained single-file publishing.

    Whisper.net ships its native libraries as content files under runtimes/<variant>/<rid>/ and probes them
    relative to the application base directory. IncludeAllContentForSelfExtract bundles them into the exe and
    extracts them (once, cached) to a temp folder at startup, which then becomes the application base directory.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- CUDA runtimes are large (~150 MB each), so they are opt-in: pass -p:IncludeCuda=true to dotnet publish -->
  <PropertyGroup>
    <IncludeCuda Condition="'$(IncludeCuda)' == ''">false</IncludeCuda>
  </PropertyGroup>

  <ItemGroup>
    <!-- CPU runtime (AVX2) plus a fallback for older CPUs without AVX. -->
    <PackageReference Include="Whisper.net.Runtime" Version="$(WhisperNetVersion)" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="$(WhisperNetVersion)" />
    <!-- GPU via Vulkan: works with the regular graphics driver on NVIDIA, AMD and Intel GPUs. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="$(WhisperNetVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeCuda)' == 'true'">
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="$(WhisperNetVersion)" />
    <PackageReference Include="Whisper.net.Runtime.Cuda12.Windows" Version="$(WhisperNetVersion)" />
  </ItemGroup>

  <!--
    Optional app-local Visual C++ runtime (msvcp140.dll, vcruntime140.dll, vcruntime140_1.dll), needed by the
    native whisper libraries on PCs without the VC++ Redistributable. The release workflow copies them into
    src/vcredist/ before publishing; locally the folder is usually empty and the system copy is used.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)vcredist\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="vcredist\%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!--
    The Whisper.net runtime packages copy native libraries for every platform (win-x86, win-arm64, linux, macOS...)
    regardless of RuntimeIdentifier. When publishing for a specific RID, drop the ones that can never load.
  -->
  <Target Name="RemoveForeignWhisperRuntimes" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_ForeignWhisperRuntime Include="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/')), '^runtimes/')) and !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/')), '^runtimes/([^/]+/)?$(RuntimeIdentifier)/'))" />
      <ResolvedFileToPublish Remove="@(_ForeignWhisperRuntime)" />
    </ItemGroup>
  </Target>
</Project>
