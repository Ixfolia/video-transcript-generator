<Project>
  <!-- Settings shared by every project under src/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>VideoTranscriber</Product>
    <Description>Generate transcripts and subtitles from video files, offline, with Whisper.</Description>
    <Copyright>Copyright (c) 2026 Ixfolia</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WhisperNetVersion>1.9.1</WhisperNetVersion>
    <!-- Symbols inside the DLLs, so a single-file publish produces just the exe. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
